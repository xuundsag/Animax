# Copy to .env and keep the token private.
DISCORD_TOKEN=YOUR_USER_TOKEN_HERE
# Progress channel, not upload destination. 0 uses the command channel.
LOG_CHANNEL_ID=0
DELETE_COMMAND_TRIGGERS=true

OUTPUT_HEIGHT=1080
COMPRESSION_MODE=quality
VIDEO_PRESET=veryfast
VIDEO_CRF=19
# Lossless takes priority over compress-all. Otherwise files up to 950 MB use CRF 0 unless compress-all is on.
COMPRESS_ALL=false
LOSSLESS=false
CAPTION_FONT=liberation
# Shared encoder budget across ALL workers, clipped to detected CPU slots.
ENCODE_THREADS=4
# 0 = host-aware automatic (up to 3). Explicit 1-8 is still RAM/disk bounded.
MAX_ACTIVE_WORKERS=0
FRAME_RATE=source
# Quality mode: preferred size midpoint only; no bitrate ceiling or size-fitting pass.
# Size mode: bitrate-budget target. Not recommended for unconstrained action quality.
TARGET_SIZE_MB=450
MAX_OUTPUT_MB=950
UPLOAD_LIMIT_MB=1000
SUBTITLE_MODE=burn
DUB_FALLBACK=true

REQUEST_INTERVAL=0.25
RATE_LIMIT_COOLDOWN=300
RATE_LIMIT_RETRIES=2
EPISODE_ATTEMPTS=3
MAX_CONSECUTIVE_FAILURES=3
STATUS_INTERVAL=8
UPLOAD_DELAY=2
AUTO_RESUME=true
KEEP_DOWNLOADS=false
MAX_EPISODES=1000
MAX_TEMP_GIB=8
OPERATION_TIMEOUT=3600
RESOLVE_TIMEOUT=60
REFETCH_TIMEOUT=600
HEADLESS=true
UPLOAD_MODE=auto
# Whole upload/recovery deadline, including checks and application-level retries.
UPLOAD_TIMEOUT=1800
UPLOAD_ATTEMPTS=2
UPLOAD_FALLBACK=true
UPLOAD_CHECK_TIMEOUT=60
