# Private self-bot token. Discord prohibits automating normal user accounts; use at your own risk.
DISCORD_TOKEN=YOUR_USER_TOKEN_HERE

# Captions are burned into the 1080p episode using one of the bundled fonts.
CAPTION_FONT=liberation
# When a dub or its English captions are positively unavailable, use sub instead.
DUB_FALLBACK=true

# CPU-only encoding. Go Live output is fixed at 1920x1080, 16:9, H.264, 30 fps.
VIDEO_PRESET=ultrafast
ENCODE_THREADS=2
STREAM_BITRATE_KBPS=5000
# Lossless takes priority over compress-all. Below the safety limit, source quality is preserved unless COMPRESS_ALL is enabled.
COMPRESS_ALL=false
LOSSLESS=false
VIDEO_CRF=19
COMPRESSION_MODE=quality
FRAME_RATE=source

# Exactly one current episode plus one next-episode preparation slot.
MAX_TEMP_GIB=8
KEEP_STREAM_CACHE=false
REQUEST_INTERVAL=0.25
RESOLVE_TIMEOUT=60
OPERATION_TIMEOUT=7200
HEADLESS=true
