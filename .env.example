# Copy to .env and keep the token private.
DISCORD_TOKEN=YOUR_USER_TOKEN_HERE
CHANNEL_ID=0
DELETE_COMMAND_TRIGGERS=true

OUTPUT_HEIGHT=1080
COMPRESSION_MODE=quality
VIDEO_PRESET=veryfast
VIDEO_CRF=19
ENCODE_THREADS=4
FRAME_RATE=source
# Quality mode: preferred size midpoint only; no bitrate ceiling or size-fitting pass.
# Size mode: bitrate-budget target. Not recommended for unconstrained action quality.
TARGET_SIZE_MB=450
MAX_OUTPUT_MB=1000
UPLOAD_LIMIT_MB=1000
ALLOW_SIZE_REENCODE=false
SUBTITLE_MODE=burn
DUB_FALLBACK=true

REQUEST_INTERVAL=0.25
RATE_LIMIT_COOLDOWN=300
RATE_LIMIT_RETRIES=2
EPISODE_ATTEMPTS=3
MAX_CONSECUTIVE_FAILURES=3
STATUS_INTERVAL=8
UPLOAD_DELAY=2
AUTO_RESUME=true
KEEP_DOWNLOADS=false
MAX_EPISODES=1000
MAX_TEMP_GIB=8
OPERATION_TIMEOUT=3600
RESOLVE_TIMEOUT=60
REFETCH_TIMEOUT=600
HEADLESS=true
UPLOAD_MODE=auto
# Whole upload/recovery deadline, including checks and application-level retries.
UPLOAD_TIMEOUT=1800
UPLOAD_ATTEMPTS=2
UPLOAD_FALLBACK=true
UPLOAD_CHECK_TIMEOUT=60
